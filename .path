export PATH="$HOME/.local/bin:$PATH"
system_uname=$( uname )
case $system_uname in
  Linux)
    export PATH=$PATH:~/.rbenv/bin
    export PATH=$PATH:~/.rbenv/plugins/ruby-build/bin
    ;;
  Darwin)
    export PATH=$PATH:~/dev/go/bin
    export PATH=$PATH:~/dev/installed/flutter/bin
    ;;
  *)
    ;;
esac
